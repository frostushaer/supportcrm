generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Region {
  id           String        @id @default(cuid())
  name         String        @unique
  state        String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  participants Participant[]
  questions    Question[]
  feedbacks    Feedback[]
  complaints   Complaint[]
  policies     Policy[]
  formTemplates FormTemplate[]
}

model Participant {
  id                         String              @id @default(cuid())
  firstName                  String
  lastName                   String
  gender                     String
  dateOfBirth                DateTime
  languageSpoken             String?
  culturalBackground         String?
  ethnicity                  String?
  aboutMe                    String?
  primaryEmailAddress        String
  primaryPhoneNumber         String
  secondaryPhoneNumber       String?
  address                    String
  suburb                     String
  state                      String
  postcode                   String
  emergencyContactName       String?
  emergencyContactNumber     String?
  ndisNumber                 String              @unique
  planNominee                String?
  serviceStartDate           DateTime?
  serviceEndDate             DateTime?
  serviceSupport             String
  auditParticipation         Boolean             @default(false)
  participantConditions      String?
  importantAlert             String?
  shiftInstructions          String?
  externalCoordinatorName    String?
  externalCoordinatorEmail   String?
  externalCoordinatorPhone   String?
  externalCoordinatorCompany String?
  status                     String              @default("Active")
  timezone                   String?
  planManagedBy              String?
  regionId                   String
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  appointments               Appointment[]
  caseNotes                  CaseNote[]
  dislikes                   Dislike[]
  documents                  Document[]
  formSubmissions            FormSubmission[]
  fundingAllocations         FundingAllocation[]
  goals                      Goal[]
  initialAssessment          InitialAssessment?
  likes                      Like[]
  medications                Medication[]
  ndisPlans                  NDISPlan[]
  region                     Region              @relation(fields: [regionId], references: [id])
  riskAssessments            RiskAssessment[]
  shiftNotes                 ShiftNote[]
  tasks                      Task[]
}

model NDISPlan {
  id              String      @id @default(cuid())
  participantId   String
  planStartDate   DateTime
  planEndDate     DateTime
  managementStyle String
  totalFunding    Float
  totalAllocated  Float       @default(0)
  totalDelivered  Float       @default(0)
  status          String      @default("Active")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Document {
  id            String      @id @default(cuid())
  participantId String
  fileName      String
  fileUrl       String
  fileType      String
  fileSize      Int         @default(0)
  uploadedBy    String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model CaseNote {
  id               String      @id @default(cuid())
  participantId    String
  subject          String?
  content          String
  date             DateTime    @default(now())
  timeSpent        String?
  howContacted     String?
  travelKm         String?
  billable         Boolean     @default(false)
  showToWorker     Boolean     @default(false)
  attachmentUrl    String?
  createdBy        String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  nonDirectSupport String?
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Medication {
  id             String      @id @default(cuid())
  participantId  String
  medicationName String
  dosage         String?
  frequency      String?
  prescribedBy   String?
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model ShiftNote {
  id            String      @id @default(cuid())
  participantId String
  shiftDate     DateTime
  workerId      String?
  content       String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Task {
  id            String      @id @default(cuid())
  participantId String
  title         String
  description   String?
  dueDate       DateTime?
  dueTime       String?
  priority      String      @default("Medium")
  status        String      @default("Pending")
  category      String?
  staffNotes    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Appointment {
  id              String      @id @default(cuid())
  participantId   String
  title           String
  appointmentDate DateTime
  appointmentTime String?
  location        String?
  notes           String?
  createdAt       DateTime    @default(now())
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Goal {
  id               String      @id @default(cuid())
  participantId    String
  description      String
  goalType         String
  progress         Int         @default(0)
  achievementNotes String?
  hurdles          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Like {
  id            String      @id @default(cuid())
  participantId String
  description   String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Dislike {
  id            String      @id @default(cuid())
  participantId String
  description   String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model RiskAssessment {
  id            String      @id @default(cuid())
  participantId String
  formName      String
  status        String      @default("Draft")
  likelihood    String?
  impact        String?
  riskRating    String?
  submittedDate DateTime?
  expiryDate    DateTime?
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model InitialAssessment {
  id                     String      @id @default(cuid())
  participantId          String      @unique
  languageSpoken         String?
  culturalBackground     String?
  ethnicity              String?
  aboutMe                String?
  planValidUntil         DateTime?
  medicalProviders       Json?
  interests              Json?
  strength               String?
  areasForImprovement    String?
  participantPreferences String?
  aboriginal             String?
  culturalPractices      String?
  genderRestriction      String?
  specialConsiderations  String?
  educationLevel         String?
  educationNotes         String?
  employmentStatus       String?
  employmentNotes        String?
  primaryDisability      String?
  secondaryDisability    String?
  physicalRestrictions   String?
  hearingImpairment      String?
  visualImpairment       String?
  communicateNeeds       String?
  nonVerbalMethod        String?
  communicationAid       String?
  followInstructions     String?
  respondToName          String?
  communicatePain        String?
  communicationNotes     String?
  dependency             String?
  needsPhysicalSupport   String?
  usesWheelchair         String?
  physicalAssistance     String?
  physicalActivities     Json?
  physicalOther          String?
  degreeOfReliance       String?
  behaviorsOfConcern     Json?
  behaviorTriggers       String?
  behaviorStrategies     String?
  servicesRequired       Json?
  medicationNotes        String?
  medicationAllergies    String?
  morningRoutine         String?
  afternoonRoutine       String?
  eveningRoutine         String?
  importantNumbers       Json?
  importantServices      Json?
  insuranceProvider      String?
  insurancePolicyNumber  String?
  importantItems         Json?
  emergencyPlan          String?
  evacuationPlan         String?
  participantSignature   String?
  participantSignDate    DateTime?
  staffSignature         String?
  staffSignDate          DateTime?
  status                 String      @default("Draft")
  submittedAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  participant            Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model FormSubmission {
  id              String      @id @default(cuid())
  participantId   String
  formName        String
  status          String      @default("Draft")
  submittedBy     String
  submittedDate   DateTime?
  lastUpdatedBy   String?
  lastUpdatedDate DateTime?
  expiryDate      DateTime?
  version         Int         @default(1)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model FundingAllocation {
  id             String      @id @default(cuid())
  participantId  String
  fundingId      String
  startDate      DateTime
  endDate        DateTime
  totalFunding   Float
  totalAllocated Float       @default(0)
  totalDelivered Float       @default(0)
  unallocated    Float       @default(0)
  status         String      @default("Active")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Question {
  id          String   @id @default(cuid())
  name        String
  subject     String
  category    String
  details     String   @db.Text
  userRole    String?
  submittedBy String
  regionId    String?

  region      Region?  @relation(fields: [regionId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Feedback {
  id             String   @id @default(cuid())
  name           String
  subject        String
  category       String
  details        String   @db.Text
  attachmentUrl  String?
  attachmentName String?
  status         String   @default("New")
  userRole       String?
  submittedBy    String
  regionId       String?

  region         Region?  @relation(fields: [regionId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([regionId])
  @@index([status])
}

model Complaint {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  subject     String
  details     String   @db.Text
  userRole    String?
  submittedBy String
  regionId    String?

  region      Region?  @relation(fields: [regionId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([regionId])
}

model Policy {
  id             String   @id @default(cuid())
  fileName       String
  category       String
  fileUrl        String
  fileType       String?
  fileSize       Int?
  uploadedBy     String
  uploadedByName String?
  regionId       String?

  region         Region?  @relation(fields: [regionId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([regionId])
}

model FormTemplate {
  id            String   @id @default(cuid())
  title         String
  category      String
  subcategory   String?
  description   String?  @db.Text
  status        String   @default("Draft")
  kind          String   @default("HomeMgt")
  regionId      String?
  createdBy     String
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  region        Region?  @relation(fields: [regionId], references: [id])
  sections      FormSection[]

  @@index([regionId])
  @@index([status])
}

model FormSection {
  id             String         @id @default(cuid())
  formTemplateId String
  title          String
  order          Int            @default(0)
  
  formTemplate   FormTemplate   @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  subSections    FormSubSection[]
  fields         FormField[]

  @@index([formTemplateId])
}

model FormSubSection {
  id            String        @id @default(cuid())
  formSectionId String
  title         String
  order         Int           @default(0)
  addOther      Boolean       @default(false)
  
  formSection   FormSection   @relation(fields: [formSectionId], references: [id], onDelete: Cascade)
  fields        FormField[]

  @@index([formSectionId])
}

model FormField {
  id                 String          @id @default(cuid())
  formSectionId      String?
  formSubSectionId   String?
  label              String
  type               String          
  required           Boolean         @default(false)
  fullWidth          Boolean         @default(false)
  addedInSupportPlan Boolean         @default(false)
  dependentOnFieldId String?
  hint               String?         @db.Text
  legalReference     String?         @db.Text
  order              Int             @default(0)

  formSection        FormSection?    @relation(fields: [formSectionId], references: [id], onDelete: Cascade)
  formSubSection     FormSubSection? @relation(fields: [formSubSectionId], references: [id], onDelete: Cascade)
  
  @@index([formSectionId])
  @@index([formSubSectionId])
}
