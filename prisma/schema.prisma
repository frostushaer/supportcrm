generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Region {
  id                       String                    @id @default(cuid())
  name                     String                    @unique
  state                    String
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  participants             Participant[]
  questions                Question[]
  feedbacks                Feedback[]
  complaints               Complaint[]
  policies                 Policy[]
  formTemplates            FormTemplate[]
  workers                  Worker[]
  homes                    HomeProperty[]
  incidents                Incident[]
  shifts                   Shift[]
  invoices                 Invoice[]
  applicants               Applicant[]
  portalUsers              PrimaryPortalUser[]       @relation("PortalUserRegions")
  cosParticipantProfiles   CosParticipantProfile[]
  externalServiceProviders ExternalServiceProvider[] @relation("ServiceProviderRegions")
  cosCaseNotes             CosCaseNote[]
  ndisClaims               NdisClaim[]
  cosInvoices              CosInvoice[]
}

model Participant {
  id                         String                 @id @default(cuid())
  firstName                  String
  lastName                   String
  gender                     String
  dateOfBirth                DateTime
  languageSpoken             String?
  culturalBackground         String?
  ethnicity                  String?
  aboutMe                    String?
  primaryEmailAddress        String
  primaryPhoneNumber         String
  secondaryPhoneNumber       String?
  address                    String
  suburb                     String
  state                      String
  postcode                   String
  emergencyContactName       String?
  emergencyContactNumber     String?
  ndisNumber                 String                 @unique
  planNominee                String?
  serviceStartDate           DateTime?
  serviceEndDate             DateTime?
  serviceSupport             String
  auditParticipation         Boolean                @default(false)
  participantConditions      String?
  importantAlert             String?
  shiftInstructions          String?
  externalCoordinatorName    String?
  externalCoordinatorEmail   String?
  externalCoordinatorPhone   String?
  externalCoordinatorCompany String?
  status                     String                 @default("Active")
  timezone                   String?
  planManagedBy              String?
  regionId                   String
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  appointments               Appointment[]
  caseNotes                  CaseNote[]
  dislikes                   Dislike[]
  documents                  Document[]
  formSubmissions            FormSubmission[]
  fundingAllocations         FundingAllocation[]
  goals                      Goal[]
  initialAssessment          InitialAssessment?
  likes                      Like[]
  medications                Medication[]
  ndisPlans                  NDISPlan[]
  region                     Region                 @relation(fields: [regionId], references: [id])
  riskAssessments            RiskAssessment[]
  shiftNotes                 ShiftNote[]
  tasks                      Task[]
  shifts                     Shift[]
  incidents                  Incident[]
  invoices                   Invoice[]
  assignedWorkers            Worker[]               @relation("WorkerAssignedParticipants")
  cosProfile                 CosParticipantProfile?
  cosFundings                CosFunding[]
  cosCaseNotes               CosCaseNote[]
  ndisClaims                 NdisClaim[]
  cosInvoices                CosInvoice[]
}

model NDISPlan {
  id              String      @id @default(cuid())
  participantId   String
  planStartDate   DateTime
  planEndDate     DateTime
  managementStyle String
  totalFunding    Float
  totalAllocated  Float       @default(0)
  totalDelivered  Float       @default(0)
  status          String      @default("Active")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Document {
  id            String      @id @default(cuid())
  participantId String
  fileName      String
  fileUrl       String
  fileType      String
  fileSize      Int         @default(0)
  uploadedBy    String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model CaseNote {
  id               String      @id @default(cuid())
  participantId    String
  subject          String?
  content          String
  date             DateTime    @default(now())
  timeSpent        String?
  howContacted     String?
  travelKm         String?
  billable         Boolean     @default(false)
  showToWorker     Boolean     @default(false)
  attachmentUrl    String?
  createdBy        String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  nonDirectSupport String?
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Medication {
  id             String      @id @default(cuid())
  participantId  String
  medicationName String
  dosage         String?
  frequency      String?
  prescribedBy   String?
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model ShiftNote {
  id            String      @id @default(cuid())
  participantId String
  shiftDate     DateTime
  workerId      String?
  content       String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Task {
  id            String      @id @default(cuid())
  participantId String
  title         String
  description   String?
  dueDate       DateTime?
  dueTime       String?
  priority      String      @default("Medium")
  status        String      @default("Pending")
  category      String?
  staffNotes    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Appointment {
  id              String      @id @default(cuid())
  participantId   String
  title           String
  appointmentDate DateTime
  appointmentTime String?
  location        String?
  notes           String?
  createdAt       DateTime    @default(now())
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Goal {
  id               String      @id @default(cuid())
  participantId    String
  description      String
  goalType         String
  progress         Int         @default(0)
  achievementNotes String?
  hurdles          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Like {
  id            String      @id @default(cuid())
  participantId String
  description   String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Dislike {
  id            String      @id @default(cuid())
  participantId String
  description   String
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model RiskAssessment {
  id            String      @id @default(cuid())
  participantId String
  formName      String
  status        String      @default("Draft")
  likelihood    String?
  impact        String?
  riskRating    String?
  submittedDate DateTime?
  expiryDate    DateTime?
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model InitialAssessment {
  id                     String      @id @default(cuid())
  participantId          String      @unique
  languageSpoken         String?
  culturalBackground     String?
  ethnicity              String?
  aboutMe                String?
  planValidUntil         DateTime?
  medicalProviders       Json?
  interests              Json?
  strength               String?
  areasForImprovement    String?
  participantPreferences String?
  aboriginal             String?
  culturalPractices      String?
  genderRestriction      String?
  specialConsiderations  String?
  educationLevel         String?
  educationNotes         String?
  employmentStatus       String?
  employmentNotes        String?
  primaryDisability      String?
  secondaryDisability    String?
  physicalRestrictions   String?
  hearingImpairment      String?
  visualImpairment       String?
  communicateNeeds       String?
  nonVerbalMethod        String?
  communicationAid       String?
  followInstructions     String?
  respondToName          String?
  communicatePain        String?
  communicationNotes     String?
  dependency             String?
  needsPhysicalSupport   String?
  usesWheelchair         String?
  physicalAssistance     String?
  physicalActivities     Json?
  physicalOther          String?
  degreeOfReliance       String?
  behaviorsOfConcern     Json?
  behaviorTriggers       String?
  behaviorStrategies     String?
  servicesRequired       Json?
  medicationNotes        String?
  medicationAllergies    String?
  morningRoutine         String?
  afternoonRoutine       String?
  eveningRoutine         String?
  importantNumbers       Json?
  importantServices      Json?
  insuranceProvider      String?
  insurancePolicyNumber  String?
  importantItems         Json?
  emergencyPlan          String?
  evacuationPlan         String?
  participantSignature   String?
  participantSignDate    DateTime?
  staffSignature         String?
  staffSignDate          DateTime?
  status                 String      @default("Draft")
  submittedAt            DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  participant            Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model FormSubmission {
  id              String      @id @default(cuid())
  participantId   String
  formName        String
  status          String      @default("Draft")
  submittedBy     String
  submittedDate   DateTime?
  lastUpdatedBy   String?
  lastUpdatedDate DateTime?
  expiryDate      DateTime?
  version         Int         @default(1)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model FundingAllocation {
  id             String      @id @default(cuid())
  participantId  String
  fundingId      String
  startDate      DateTime
  endDate        DateTime
  totalFunding   Float
  totalAllocated Float       @default(0)
  totalDelivered Float       @default(0)
  unallocated    Float       @default(0)
  status         String      @default("Active")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Question {
  id          String  @id @default(cuid())
  name        String
  subject     String
  category    String
  details     String  @db.Text
  userRole    String?
  submittedBy String
  regionId    String?

  region Region? @relation(fields: [regionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id             String  @id @default(cuid())
  name           String
  subject        String
  category       String
  details        String  @db.Text
  attachmentUrl  String?
  attachmentName String?
  status         String  @default("New")
  userRole       String?
  submittedBy    String
  regionId       String?

  region Region? @relation(fields: [regionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
  @@index([status])
}

model Complaint {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  subject     String
  details     String   @db.Text
  userRole    String?
  submittedBy String
  regionId    String?

  region Region? @relation(fields: [regionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
}

model Policy {
  id             String  @id @default(cuid())
  fileName       String
  category       String
  fileUrl        String
  fileType       String?
  fileSize       Int?
  uploadedBy     String
  uploadedByName String?
  regionId       String?

  region Region? @relation(fields: [regionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
}

model FormTemplate {
  id            String   @id @default(cuid())
  title         String
  category      String
  subcategory   String?
  description   String?  @db.Text
  status        String   @default("Draft")
  kind          String   @default("HomeMgt")
  regionId      String?
  createdBy     String
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  region   Region?       @relation(fields: [regionId], references: [id])
  sections FormSection[]

  @@index([regionId])
  @@index([status])
}

model FormSection {
  id             String @id @default(cuid())
  formTemplateId String
  title          String
  order          Int    @default(0)

  formTemplate FormTemplate     @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  subSections  FormSubSection[]
  fields       FormField[]

  @@index([formTemplateId])
}

model FormSubSection {
  id            String  @id @default(cuid())
  formSectionId String
  title         String
  order         Int     @default(0)
  addOther      Boolean @default(false)

  formSection FormSection @relation(fields: [formSectionId], references: [id], onDelete: Cascade)
  fields      FormField[]

  @@index([formSectionId])
}

model FormField {
  id                 String  @id @default(cuid())
  formSectionId      String?
  formSubSectionId   String?
  label              String
  type               String
  required           Boolean @default(false)
  fullWidth          Boolean @default(false)
  addedInSupportPlan Boolean @default(false)
  dependentOnFieldId String?
  hint               String? @db.Text
  legalReference     String? @db.Text
  order              Int     @default(0)

  formSection    FormSection?    @relation(fields: [formSectionId], references: [id], onDelete: Cascade)
  formSubSection FormSubSection? @relation(fields: [formSubSectionId], references: [id], onDelete: Cascade)

  @@index([formSectionId])
  @@index([formSubSectionId])
}

// Staff/Support Worker
model Worker {
  id                String    @id @default(cuid())
  firstName         String
  lastName          String
  email             String    @unique
  phoneNumber       String
  role              String // Support Worker, Allied Health, Support Coordinator
  status            String // Active, Inactive, On Leave
  policeCheckExpiry DateTime?
  wwccExpiry        DateTime?
  regionId          String

  // New HRM fields
  employmentType            String? // Casual, PartTime, FullTime
  jobTitle                  String?
  salarySlab                String?
  hourlyRate                Float?
  joiningDate               DateTime?
  performanceReviewRequired Boolean   @default(false)
  profilePictureUrl         String?
  maxAllowedHours           Float?
  xeroEmployeeId            String?
  quickBooksEmployeeId      String?
  myobEmployeeId            String?
  traits                    Json?

  region            Region     @relation(fields: [regionId], references: [id])
  shifts            Shift[]
  incidentsReported Incident[] @relation("ReportedIncidents")
  incidentsInvolved Incident[] @relation("InvolvedWorkerIncidents")

  assignedParticipants Participant[]          @relation("WorkerAssignedParticipants")
  leaves               WorkerLeave[]
  availabilities       WorkerAvailability[]
  documentFolders      WorkerDocumentFolder[]
  documents            WorkerDocument[]
  trainingRecords      WorkerTrainingRecord[]
  portalUsers          PrimaryPortalUser[]
  cosFundings          CosFunding[]
  cosCaseNotes         CosCaseNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HRM: Applicants
model Applicant {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phoneNumber    String
  suburb         String?
  appliedOn      DateTime @default(now())
  jobTitle       String
  regionId       String?
  status         String   @default("Applied") // Applied, PhoneScreening, Interview, Pending, Offer, Hired, Rejected
  resumeUrl      String?
  notes          String?  @db.Text
  interviewNotes String?  @db.Text

  region Region? @relation(fields: [regionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HRM: Worker Leave
model WorkerLeave {
  id              String   @id @default(cuid())
  workerId        String
  updatedByUserId String?
  leaveType       String
  startDate       DateTime
  endDate         DateTime
  reason          String?  @db.Text
  comments        String?  @db.Text
  status          String   @default("Requested") // Requested, Approved, Rejected

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HRM: Worker Availability
model WorkerAvailability {
  id           String @id @default(cuid())
  workerId     String
  dayOfWeek    String // Mon, Tue, Wed, etc.
  availability String // e.g., "9am - 5pm" or JSON array

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HRM: Worker Document Folders
model WorkerDocumentFolder {
  id       String @id @default(cuid())
  workerId String
  name     String

  worker    Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  documents WorkerDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HRM: Worker Documents
model WorkerDocument {
  id       String  @id @default(cuid())
  workerId String
  folderId String?
  fileName String
  fileUrl  String
  fileSize Int     @default(0)

  worker Worker                @relation(fields: [workerId], references: [id], onDelete: Cascade)
  folder WorkerDocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  uploadedAt DateTime @default(now())
}

// HRM: Worker Training Records
model WorkerTrainingRecord {
  id                  String    @id @default(cuid())
  workerId            String
  formTemplateId      String?
  formName            String
  status              String    @default("Assigned") // Assigned, Submitted, Completed, Expired
  createdByUserId     String
  submittedAt         DateTime?
  lastUpdatedByUserId String?
  lastUpdatedAt       DateTime?
  expiryDate          DateTime?
  version             String?

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HRM: Primary Portal Users
model PrimaryPortalUser {
  id       String @id @default(cuid())
  workerId String
  email    String @unique
  status   String @default("Active") // Active, Inactive
  role     String @default("SupportWorker") // Admin, Manager, SupportWorker

  worker  Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  regions Region[] @relation("PortalUserRegions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SIL/SDA Property
model HomeProperty {
  id                 String  @id @default(cuid())
  regionId           String
  streetAddress      String
  suburb             String
  state              String
  postalCode         String
  propertyType       String
  sdaType            String? // Specialist Disability Accommodation
  totalRooms         Int
  totalBathrooms     Int
  totalKitchens      Int
  totalParkingSpaces Int
  totalSharedSpaces  Int
  hasFrontYard       Boolean @default(false)
  hasBackyard        Boolean @default(false)
  hasSwimmingPool    Boolean @default(false)
  vacancyStatus      String // Available, Full, Partial
  status             String // Active, Inactive

  region Region @relation(fields: [regionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Incident reporting
model Incident {
  id             String    @id @default(cuid())
  incidentNumber String    @unique
  status         String    @default("Draft") // Draft, Submitted, UnderInvestigation, ClosedReported, ClosedUnreported
  outcomeType    String? // Hazard, Incident, NearMiss, Medication
  regionId       String
  reportedById   String
  reportedByName String?
  reportedAt     DateTime?

  dateOfIncident  DateTime?
  timeOfIncident  String?
  address         String?
  location        String?
  locationDetails String?   @db.Text

  // People involved
  participants              Participant[]
  workerId                  String?
  visitorName               String?
  volunteerName             String?
  otherPersonName           String?
  responsiblePersonNotified Boolean       @default(false)

  // Response summary flags
  firstAidGiven     Boolean @default(false)
  ambulanceRequired Boolean @default(false)
  policeInvolved    Boolean @default(false)
  injuries          Boolean @default(false)
  prnGiven          Boolean @default(false)
  medicalReview     Boolean @default(false)

  // Categorisation
  incidentCategories String[]

  // Narrative / Context
  summary                           String? @db.Text
  behaviourPlanExists               Boolean @default(false)
  regulatedRestrictivePracticesUsed Boolean @default(false)
  taskAtTime                        String? @db.Text
  incidentEnd                       String? @db.Text
  whatHappened                      String? @db.Text
  circumstancesLeadingUp            String? @db.Text
  immediateAction                   String? @db.Text

  // Additional compliance
  injuriesToParticipant             Boolean @default(false)
  responsiblePersonNotifiedQuestion Boolean @default(false)
  firstAidQuestion                  Boolean @default(false)
  ambulanceQuestion                 Boolean @default(false)
  policeQuestion                    Boolean @default(false)
  prnQuestion                       Boolean @default(false)
  medicalReviewQuestion             Boolean @default(false)

  // Sign-off
  signatoryName String?
  signatureData String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region         Region  @relation(fields: [regionId], references: [id])
  reportedBy     Worker  @relation("ReportedIncidents", fields: [reportedById], references: [id])
  workerInvolved Worker? @relation("InvolvedWorkerIncidents", fields: [workerId], references: [id])

  witnesses     IncidentWitness[]
  attachments   IncidentAttachment[]
  investigation IncidentInvestigation?
  review        IncidentReview?

  @@index([regionId])
}

model IncidentWitness {
  id          String    @id @default(cuid())
  incidentId  String
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      String?
  address     String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentAttachment {
  id         String   @id @default(cuid())
  incidentId String
  fileName   String
  fileUrl    String
  fileSize   Int
  uploadedAt DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentInvestigation {
  id                     String    @id @default(cuid())
  incidentId             String    @unique
  status                 String    @default("NotStarted") // NotStarted, InProgress, Completed
  isReportable           Boolean?
  reportableDeterminedAt DateTime?

  participantNotes Json? // Array of notes
  staffNotes       Json? // Array of notes

  advocacyOffered Boolean?
  advocacyDetails String?  @db.Text

  // Investigation checks (Yes/No/NA)
  siteVisitConducted              String?
  occurredDuringRoutineActivities String?
  equipmentContributed            String?
  equipmentDesignedForTask        String?
  equipmentMaintained             String?
  equipmentFailed                 String?
  riskAssessmentDone              String?
  safetyInstructionsProvided      String?
  safeWorkProceduresDocumented    String?
  safeWorkProceduresFollowed      String?
  ppeUsed                         String?
  personTrained                   String?
  knownBehaviourIssueContributed  String?
  behaviourManagementPlanExists   String?
  behaviourManagementPlanFollowed String?
  poorHousekeepingContributed     String?
  workEnvironmentContributed      String?

  rootCauseAnalysis String? @db.Text
  remedialActions   Json? // Array of strings

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model IncidentReview {
  id                     String    @id @default(cuid())
  incidentId             String    @unique
  investigationSummary   String?   @db.Text
  reportable             Boolean?
  investigationStartedAt DateTime?
  reportableOutcome      String?

  // Risk assessment
  riskNewRisksIdentified String? // Yes/No/NA
  riskMitigationRequired String? // Yes/No/NA
  riskRecurrenceRating   String? // Nil/Low/Medium/High

  // Further action
  furtherActionNeeded  String? // Yes/No/NA
  furtherActionDetails String? @db.Text

  // Manager review
  finalStatus String? // ReportedToCommission, ClosedWithoutReporting
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

// Rostering & Shifts
model Shift {
  id            String   @id @default(cuid())
  participantId String
  workerId      String
  supportItem   String // NDIS support item code
  startDateTime DateTime
  endDateTime   DateTime
  status        String // Scheduled, Completed, Cancelled
  regionId      String
  overtime      String?

  participant Participant @relation(fields: [participantId], references: [id])
  worker      Worker      @relation(fields: [workerId], references: [id])
  region      Region      @relation(fields: [regionId], references: [id])
  timesheet   Timesheet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Timesheet for invoicing
model Timesheet {
  id              String    @id @default(cuid())
  shiftId         String    @unique
  actualStartTime DateTime
  actualEndTime   DateTime
  breakMinutes    Int       @default(0)
  totalHours      Float
  approvedBy      String?
  approvedAt      DateTime?
  status          String // Pending, Approved, Rejected
  shiftNotes      String?
  incidents       Int       @default(0)
  kms             Float     @default(0)
  associatedCost  Float     @default(0)

  // Billing / Invoicing fields
  supportItemCode String?
  quantity        Float?
  unitPrice       Float?
  totalAmount     Float?
  fundingSource   String?
  billingStatus   String  @default("NotReady") // NotReady, Allocated, Invoiced
  invoiceId       String?

  shift   Shift    @relation(fields: [shiftId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Invoices generated from Timesheets
model Invoice {
  id                   String   @id @default(cuid())
  invoiceNumber        String   @unique
  participantId        String
  participantName      String
  createdById          String
  createdByName        String?
  createdDate          DateTime @default(now())
  serviceDeliveredFrom DateTime
  serviceDeliveredTo   DateTime
  status               String   @default("Draft") // Draft, Pending, Sent, Paid, Cancelled
  numDelivered         Float    @default(0)
  totalValue           Float    @default(0)
  regionId             String?
  notes                String?  @db.Text
  externalReference    String?

  participant  Participant   @relation(fields: [participantId], references: [id])
  region       Region?       @relation(fields: [regionId], references: [id])
  invoiceLines InvoiceLine[]
  timesheets   Timesheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
  @@index([participantId])
}

// Line items for an Invoice
model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  timesheetId     String?
  workerId        String?
  workerName      String?
  participantId   String?
  participantName String?
  deliveredDate   DateTime
  typeOfService   String?
  supportItemCode String?
  quantity        Float
  unitPrice       Float
  totalAmount     Float
  fundingSource   String?
  notes           String?  @db.Text

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

// Support Coordination (COS)

enum ProgramType {
  COS
  AlliedHealth
}

model CosParticipantProfile {
  id              String    @id @default(cuid())
  participantId   String    @unique
  program         ProgramType @default(COS)
  managementStyle String
  serviceRegionId String
  ndisNumber      String    @unique
  planStartDate   DateTime?
  planEndDate     DateTime?
  quickSnapshot   String?

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  serviceRegion Region      @relation(fields: [serviceRegionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CosFunding {
  id                     String   @id @default(cuid())
  participantId          String
  program                ProgramType @default(COS)
  cosCoordinatorWorkerId String?
  serviceName            String
  serviceTotalBudget     Float
  fundingStartDate       DateTime
  fundingEndDate         DateTime
  totalFunding           Float
  fundingRemaining       Float
  fundingDelivered       Float
  notes                  String?  @db.Text

  participant Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  coordinator Worker?       @relation(fields: [cosCoordinatorWorkerId], references: [id], onDelete: SetNull)
  caseNotes   CosCaseNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CosSupportCatalogueItem {
  id                  String  @id @default(cuid())
  supportItemNumber   String
  program             ProgramType @default(COS)
  supportItemName     String
  supportCategoryName String
  priceCatalogueLabel String
  price               Float
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExternalServiceProvider {
  id                 String  @id @default(cuid())
  name               String
  program            ProgramType @default(COS)
  contactInformation String? @db.Text
  billingContact     String?

  regions Region[] @relation("ServiceProviderRegions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CosCaseNote {
  id                   String   @id @default(cuid())
  participantId        String
  program              ProgramType @default(COS)
  fundingId            String?
  serviceRegionId      String
  supportCoordinatorId String
  deliveredDate        DateTime
  durationMinutes      Int
  kilometres           Float?
  amount               Float
  noteContactType      String
  caseNoteText         String   @db.Text
  status               String   @default("Draft") // Draft, ReadyForClaim, Claimed, Invoiced
  createdByUserId      String

  participant        Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  funding            CosFunding? @relation(fields: [fundingId], references: [id], onDelete: SetNull)
  serviceRegion      Region      @relation(fields: [serviceRegionId], references: [id])
  supportCoordinator Worker      @relation(fields: [supportCoordinatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NdisClaim {
  id               String   @id @default(cuid())
  reference        String   @unique
  program          ProgramType @default(COS)
  participantId    String
  regionId         String
  claimType        String
  deliveredFrom    DateTime
  deliveredTo      DateTime
  totalAmount      Float
  status           String   @default("Draft") // Draft, Submitted, Paid, Rejected
  caseNotesSummary String?  @db.Text
  caseNoteIds      String[] // Array of case note IDs linked
  createdByUserId  String

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  region      Region      @relation(fields: [regionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CosInvoice {
  id                   String   @id @default(cuid())
  reference            String   @unique
  program              ProgramType @default(COS)
  invoiceType          String
  participantId        String
  regionId             String
  serviceDeliveredFrom DateTime
  serviceDeliveredTo   DateTime
  numDeliveredServices Int
  totalValue           Float
  status               String   @default("Draft") // Draft, Sent, Paid, Cancelled
  caseNoteIds          String[] // Array of case note IDs linked
  createdByUserId      String

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  region      Region      @relation(fields: [regionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
